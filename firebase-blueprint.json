{
  "entities": {
    "User": {
      "title": "User",
      "description": "Staff member profile in SAGI 127 contact center",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "nik": { "type": "string", "maxLength": 32 },
        "name": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "maxLength": 64 },
        "password": { "type": "string", "maxLength": 128 },
        "gender": { "type": "string", "enum": ["Pria", "Wanita"] },
        "shiftNumber": { "type": "number" },
        "role": { "type": "string", "enum": ["Admin", "SPV", "Agent"] },
        "division": { "type": "string", "maxLength": 64 },
        "supervisorName": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "updatedAt": { "type": "string" }
      },
      "required": ["nik", "name", "username", "role", "division"]
    },
    "AgentStatus": {
      "title": "AgentStatus",
      "description": "Real-time live status and current AUX activity for an agent",
      "type": "object",
      "properties": {
        "agentId": { "type": "string", "maxLength": 64 },
        "agentName": { "type": "string", "maxLength": 128 },
        "nik": { "type": "string", "maxLength": 32 },
        "role": { "type": "string", "maxLength": 32 },
        "division": { "type": "string", "maxLength": 64 },
        "shiftNumber": { "type": "number" },
        "supervisorName": { "type": "string", "maxLength": 128 },
        "currentStatus": { "type": "string", "enum": ["READY", "BREAK", "TOILET", "SHOLAT", "BRIEFING", "COACHING", "ACW", "OFFLINE"] },
        "statusStartedAt": { "type": "string" },
        "isOnline": { "type": "boolean" },
        "lastSeen": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["agentId", "agentName", "currentStatus", "statusStartedAt", "updatedAt"]
    },
    "AuxLog": {
      "title": "AuxLog",
      "description": "Historical audit entry for an AUX state transition",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "agentId": { "type": "string", "maxLength": 64 },
        "agentName": { "type": "string", "maxLength": 128 },
        "nik": { "type": "string", "maxLength": 32 },
        "division": { "type": "string", "maxLength": 64 },
        "shiftNumber": { "type": "number" },
        "status": { "type": "string", "maxLength": 32 },
        "startedAt": { "type": "string" },
        "endedAt": { "type": "string" },
        "durationSeconds": { "type": "number" },
        "isOverThreshold": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["agentId", "status", "startedAt", "createdAt"]
    },
    "SystemConfig": {
      "title": "SystemConfig",
      "description": "Global AUX thresholds and shift rules",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "auxThresholds": { "type": "object" },
        "shifts": { "type": "object" },
        "updatedAt": { "type": "string" }
      },
      "required": ["auxThresholds", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Registered contact center agents, supervisors, and administrators"
    },
    "/agent_status/{agentId}": {
      "schema": "AgentStatus",
      "description": "Live real-time status matrix synced across all clients"
    },
    "/aux_logs/{logId}": {
      "schema": "AuxLog",
      "description": "Historical log of agent auxiliary state switches"
    },
    "/system_config/{configId}": {
      "schema": "SystemConfig",
      "description": "System operational thresholds and shift configuration"
    }
  }
}
